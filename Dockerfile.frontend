FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
ARG VITE_PUBLIC_SITE_URL=https://bestpartschool.com
ARG VITE_SUPPORT_EMAIL=gabriel@bestpartschol.com
ARG VITE_ORGANIZATION_NAME="Best Part School"
ARG VITE_ORGANIZATION_ID
ENV VITE_PUBLIC_SITE_URL=$VITE_PUBLIC_SITE_URL \
    VITE_SUPPORT_EMAIL=$VITE_SUPPORT_EMAIL \
    VITE_ORGANIZATION_NAME=$VITE_ORGANIZATION_NAME \
    VITE_ORGANIZATION_ID=$VITE_ORGANIZATION_ID
RUN npm run build

FROM nginx:1.27-alpine

COPY docker/frontend/default.conf /etc/nginx/conf.d/default.conf
COPY docker/frontend/40-env-config.sh /docker-entrypoint.d/40-env-config.sh
COPY --from=build /app/dist /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.d/40-env-config.sh

EXPOSE 80
